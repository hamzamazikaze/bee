# Copy to .env.local. Every key is optional: the app falls back to local data without it.

# Gemini — image understanding, OCR, TripProfile extraction (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq — Whisper voice transcription fallback (server-side only)
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# YouTube Data API — official metadata for youtube.com / youtu.be links.
# Without it the URL chain falls back to OpenGraph for YouTube; nothing breaks.
YOUTUBE_API_KEY=

# Routing provider (walking / car segments)
ROUTING_API_KEY=
ROUTING_BASE_URL=https://router.project-osrm.org

# Weather (no key required for open-meteo)
WEATHER_BASE_URL=https://api.open-meteo.com/v1

# BENNA menu + group orders (server-side only). `supabase start` prints both;
# the anon key is safe to use here because every table is read-only RLS.
# Prefixed BENNA_ so a SUPABASE_* exported by another project's shell profile can't
# override it (Next.js lets process env win over .env files).
BENNA_SUPABASE_URL=http://127.0.0.1:54321
BENNA_SUPABASE_ANON_KEY=

# Public
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI — optional, three jobs, none of them load-bearing:
#   1. the day curator: picks which curated places AND experiences belong in this
#      traveller's day, with a "why this stop, for you" line in their language
#   2. Whisper voice transcription when GROQ_API_KEY is absent
#   3. a second brain for intent/image when Gemini is slow
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# gpt-4o-transcribe reads Moroccan Darija; whisper-1 hallucinates on it. See /test-openai.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Voice engine policy.
#   darija (default) MoulSot answers for everyone. ~20s, and never wrong about Darija.
#   auto             Whisper first (~1s), MoulSot only when the audio turns out to be
#                    Darija. Faster for European languages, but by inference.
# The default ships, so a deployment nobody configured behaves like the demo machine.
VOICE_ENGINE=darija

# Developer laboratories (/test-ai, /test-ai-darija, /test-openai) and the six
# /api/test-* routes behind them. On by default while developing; off wherever
# NODE_ENV is production, because they are unauthenticated and spend API credits.
# Set to 1 to reach them on a deployment.
ENABLE_DIAGNOSTICS=

# BENNA orders + WhatsApp state are written with the service role key (server-only, bypasses
# RLS). `supabase status -o env` prints SERVICE_ROLE_KEY.
BENNA_SUPABASE_SERVICE_ROLE_KEY=
# Opens /admin/commandes?token=<this>
BENNA_ADMIN_TOKEN=
# Human hand-off for the WhatsApp bot: international number, digits only (e.g. 2126XXXXXXXX)
BENNA_SUPPORT_PHONE=

# Meta WhatsApp Cloud API — see WHATSAPP_SETUP.md. Token or phone id empty = dry-run (replies logged).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
WHATSAPP_ENABLED=true
# true = log replies instead of sending, even with a token (terminal demo with scripts/whatsapp-sim.mts)
WHATSAPP_DRY_RUN=false
# Twilio WhatsApp Sandbox instead of Meta (text only, works without business verification)
WHATSAPP_PROVIDER=meta
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Exact URL set in Twilio (needed behind a tunnel to check X-Twilio-Signature)
TWILIO_WEBHOOK_URL=
# WhatsApp Web bridge on a spare number (WHATSAPP_PROVIDER=bridge, run scripts/whatsapp-bridge.mts)
WHATSAPP_BRIDGE_SECRET=
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001

# Optional: makes the dev server private. Each device opens /?pass=<value> once.
BENNA_DEV_PASS=

# Optional: "jury" publishes only the QR order path (/casanearshore → menu → plat → panier →
# commande); every other page redirects to /casanearshore and /api is closed.
NEXT_PUBLIC_BENNA_SCOPE=

# Optional: live jury board. Orders from QR guests are relayed on this secret ntfy.sh topic
# (first name + dishes only) and shown on /live?token=<BENNA_ADMIN_TOKEN>.
BENNA_LIVE_TOPIC=
