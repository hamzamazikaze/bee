/**
 * Writes supabase/seed.sql from src/features/benna/data.ts — one source for the app's demo
 * menu and the database, so M3AK (Supabase) and the cart (data.ts) can never disagree.
 *
 *   node scripts/benna-seed.mts && supabase db reset
 */
import { writeFileSync } from "node:fs";
import { DISHES, GROUP, KITCHENS, WORKPLACES, menuIdsFor } from "../src/features/benna/data.ts";

const q = (value: string | null | undefined) => (value == null ? "null" : `'${value.replaceAll("'", "''")}'`);
const arr = (values: string[]) => (values.length ? `array[${values.map(q).join(", ")}]::text[]` : "'{}'::text[]");
const rows = (lines: string[]) => lines.join(",\n  ");

const rotation = [1, 2, 3, 4, 5].flatMap((day) => menuIdsFor(day).map((id) => `(${day}, ${q(id)})`));

const sql = `-- GENERATED by scripts/benna-seed.mts from src/features/benna/data.ts — do not edit by hand.
-- DEMO VALUES: prices follow the brief's hypothesis; workplaces, kitchens and their
-- declared ingredients/allergens are placeholders until real kitchens provide them.

insert into workplaces (id, name, area, pickup, code, city) values
  ${rows(WORKPLACES.map((w) => `(${q(w.id)}, ${q(w.name)}, ${q(w.area)}, ${q(w.pickup)}, ${q(w.code)}, ${q(w.city)})`))};

insert into kitchens (id, name, blurb, district, city) values
  ${rows(KITCHENS.map((k) => `(${q(k.id)}, ${q(k.name)}, ${q(k.blurb)}, ${q(k.district)}, ${q(k.city)})`))};

-- A kitchen delivers every workplace in its own city.
insert into kitchen_workplaces (kitchen_id, workplace_id)
select k.id, w.id from kitchens k join workplaces w on w.city = k.city;

insert into dishes (id, kitchen_id, name, description, slot, group_price_mad, solo_price_mad, ingredients, allergens, tag, image) values
  ${rows(DISHES.map((d) => `(${q(d.id)}, ${q(d.kitchenId)}, ${q(d.name)}, ${q(d.description)}, ${q(d.slot)}, ${d.groupPrice}, ${d.soloPrice}, ${arr(d.ingredients)}, ${arr(d.allergens)}, ${q(d.tag)}, ${q(d.image)})`))};

-- Two weeks of menus from today (Casablanca). Weekends serve Monday's rotation (demo).
with rotation (day, dish_id) as (values
  ${rows(rotation)}
), days as (
  select ((now() at time zone 'Africa/Casablanca')::date + offs) as served_on
  from generate_series(0, 13) as offs
)
insert into menu_days (dish_id, served_on)
select r.dish_id, d.served_on
from days d
join rotation r on r.day = case when extract(isodow from d.served_on) between 1 and 5
  then extract(isodow from d.served_on)::int else 1 end;

-- Today's group order stays open 3 hours after a reset; later days close at 10:30 local.
insert into group_orders (workplace_id, name, host_name, served_on, delivery_time, cutoff_at, capacity)
select w.id, ${q(GROUP.name)}, ${q(GROUP.host)}, d.served_on, ${q(GROUP.delivery)},
  case when d.served_on = (now() at time zone 'Africa/Casablanca')::date
    then now() + interval '3 hours'
    else (d.served_on + time '10:30') at time zone 'Africa/Casablanca' end,
  ${GROUP.capacity}
from workplaces w
cross join (select ((now() at time zone 'Africa/Casablanca')::date + offs) as served_on from generate_series(0, 13) as offs) d;
`;

writeFileSync(new URL("../supabase/seed.sql", import.meta.url), sql);
console.log(`seed.sql: ${WORKPLACES.length} workplaces, ${KITCHENS.length} kitchens, ${DISHES.length} dishes, ${rotation.length} rotation rows`);
