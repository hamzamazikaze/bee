{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/ONBOARDING.md"],
  "permission": {
    "shell": {
      "*": "ask",
      "pnpm *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git switch *": "allow",
      "git add *": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "git push origin main*": "deny",
      "git push * main": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git merge *": "deny",
      "git rebase *": "ask",
      "git reset --hard*": "deny",
      "gh pr create*": "ask",
      "gh pr merge*": "deny",
      "rm -rf *": "deny"
    }
  }
}
